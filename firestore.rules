rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Peter – plný prístup (zadávanie aj prehľad)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'bezuska.peter@gmail.com';
    }

    // Manželka – iba prezeranie (prehľad)
    function isViewer() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'macka.masarovicova@gmail.com';
    }

    match /{document=**} {
      allow read: if isOwner() || isViewer();
      allow write: if isOwner();
    }
  }
}
